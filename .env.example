# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# Turso / libSQL cloud database. These are server-side secrets only.
# Get the database URL and token from the Turso dashboard or CLI.
TURSO_DATABASE_URL="libsql://YOUR-DATABASE-YOUR-ORG.turso.io"
TURSO_AUTH_TOKEN="YOUR_TURSO_DATABASE_TOKEN"
